-- Function to start auto tap with maximum speed
local function startAutoTap()
    if not ResourceController.isSafe then return end
    
    -- Clear existing threads safely
    for _, thread in pairs(AllThreads) do
        if type(thread) == "thread" then
            pcall(function() task.cancel(thread) end)
        end
    end
    AllThreads = {}
    
    -- Reset performance monitor
    PerformanceMonitor.failures = 0
    PerformanceMonitor.lastSuccessful = tick()
    
    -- Multi-threaded burst system
    local burstConfigs = {
        Normal = {threads = 3, amount = 500000, delay = 0.01},
        Fast = {threads = 5, amount = 500000, delay = 0.005},
        Ultra = {threads = 8, amount = 500000, delay = 0.001},
        TURBO = {threads = 12, amount = 500000, delay = 0} -- New TURBO mode
    }
    
    local currentConfig = burstConfigs[Config.TapMode]
    
    -- Create multiple burst threads
    for i = 1, currentConfig.threads do
        local burstThread = task.spawn(function()
            while Config.AutoTap and ResourceController.isSafe do
                task.spawn(function()
                    for j = 1, currentConfig.amount do
                        if not Config.AutoTap or not ResourceController.isSafe then break end
                        safeTap()
                    end
                end)
                task.wait(currentConfig.delay)
            end
        end)
        table.insert(AllThreads, burstThread)
    end
    
    -- Continuous rapid tap thread
    local rapidThread = task.spawn(function()
        while Config.AutoTap and ResourceController.isSafe do
            for i = 1, 500000 do
                if not Config.AutoTap then break end
                safeTap()
            end
            task.wait()
        end
    end)
    table.insert(AllThreads, rapidThread)
    
    -- Super burst thread
    local superBurstThread = task.spawn(function()
        while Config.AutoTap and ResourceController.isSafe do
            if Config.TapMode == "TURBO" then
                for i = 1, 10 do
                    task.spawn(function()
                        for j = 1, 500000 do
                            if not Config.AutoTap or not ResourceController.isSafe then break end
                            safeTap()
                        end
                    end)
                end
            end
            task.wait(0.01)
        end
    end)
    table.insert(AllThreads, superBurstThread)
    
    -- Start performance monitoring
    checkPerformance()
end

-- Make frame draggable
local UserInputService = game:GetService("UserInputService")
local dragging
local dragInput
local dragStart
local startPos

local function update(input)
    local delta = input.Position - dragStart
    MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        update(input)
    end
end)

-- Setup cleanup handlers
local function setupCleanupHandlers()
    -- Cleanup when GUI is destroyed
    ScreenGui.Destroying:Connect(fullCleanup)
    
    -- Cleanup when player leaves
    game:GetService("Players").PlayerRemoving:Connect(function(player)
        if player == game:GetService("Players").LocalPlayer then
            fullCleanup()
        end
    end)
    
    -- Cleanup when game closes
    game:BindToClose(function()
        fullCleanup()
    end)
    
    -- Cleanup on character respawn
    game:GetService("Players").LocalPlayer.CharacterAdded:Connect(fullCleanup)
end

-- Speed Mode cycle handler
SpeedModeButton.MouseButton1Click:Connect(function()
    local modes = {"Normal", "Fast", "Ultra", "TURBO"}
    local currentIndex = table.find(modes, Config.TapMode)
    Config.TapMode = modes[currentIndex % #modes + 1]
    SpeedModeButton.Text = "Mode: " .. Config.TapMode
    
    -- Restart auto tap if it's running
    if Config.AutoTap then
        Config.AutoTap = false
        task.wait(0.1)
        Config.AutoTap = true
        startAutoTap()
    end
end)

-- Button handlers
AutoTapButton.MouseButton1Click:Connect(function()
    if not ResourceController.isSafe then
        ResourceController.isSafe = true
        ResourceController.warningLevel = 0
    end
    
    Config.AutoTap = not Config.AutoTap
    UpdateButton(AutoTapButton, Config.AutoTap)
    
    if Config.AutoTap then
        startAutoTap()
    else
        -- Enhanced cleanup when turning off
        fullCleanup()
        task.wait(0.1)
        for _, thread in pairs(AllThreads) do
            pcall(function() task.cancel(thread) end)
        end
        AllThreads = {}
    end
end)

AutoRebirthButton.MouseButton1Click:Connect(function()
    Config.AutoRebirth = not Config.AutoRebirth
    UpdateButton(AutoRebirthButton, Config.AutoRebirth)
end)

AutoUpgradeButton.MouseButton1Click:Connect(function()
    Config.AutoUpgrade = not Config.AutoUpgrade
    UpdateButton(AutoUpgradeButton, Config.AutoUpgrade)
end)

