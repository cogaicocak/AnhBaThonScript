-- Initialize configuration
local Config = {
    AutoTap = false,
    AutoRebirth = false,
    AutoUpgrade = false,
    TapMode = "Normal" -- Normal, Fast, Ultra, TURBO
}

local cleaning = false
local AllThreads = {}
local ResourceController = {}
local PerformanceMonitor = {
    failures = 0,
    maxFailures = 5,
    lastSuccessful = 0,
    autoAdjust = true
}

-- Function to monitor and control resource usage
function ResourceController:Init()
    self.isSafe = true
    self.warningLevel = 0
    
    -- Monitor thread performance
    task.spawn(function()
        while true do
            if #AllThreads > 1000 then
                self.warningLevel = self.warningLevel + 1
            else
                self.warningLevel = math.max(0, self.warningLevel - 1)
            end
            
            if self.warningLevel >= 5 then
                self.isSafe = false
                fullCleanup()
            end
            
            task.wait(0.1)
        end
    end)
end

-- Performance check function
local function checkPerformance()
    task.spawn(function()
        while Config.AutoTap do
            local currentTime = tick()
            if currentTime - PerformanceMonitor.lastSuccessful > 5 then
                -- Reset script if no successful taps in 5 seconds
                fullCleanup()
                task.wait(1)
                if Config.AutoTap then
                    startAutoTap()
                end
            end
            task.wait(1)
        end
    end)
end

-- Auto recovery function
local function autoRecovery()
    task.spawn(function()
        while true do
            if Config.AutoTap and not ResourceController.isSafe then
                ResourceController.isSafe = true
                ResourceController.warningLevel = 0
                startAutoTap()
            end
            task.wait(5)
        end
    end)
end

-- Enhanced cleanup function
local function fullCleanup()
    if cleaning then return end
    cleaning = true
    
    -- Turn off all features
    Config.AutoTap = false
    Config.AutoRebirth = false
    Config.AutoUpgrade = false
    
    -- Cancel all threads
    for _, thread in pairs(AllThreads) do
        if type(thread) == "thread" then
            pcall(function()
                task.cancel(thread)
            end)
        end
    end
    AllThreads = {}
    
    -- Reset performance monitor
    PerformanceMonitor.failures = 0
    PerformanceMonitor.lastSuccessful = tick()
    
    -- Clear memory
    task.wait(0.1)
    game:GetService("Debris"):AddItem(Instance.new("Folder"), 0)
    
    -- Force GC
    for i = 1, 3 do
        game:GetService("RunService").Heartbeat:Wait()
    end
    
    cleaning = false
end

-- Optimized tap function with performance monitoring
local function safeTap()
    local success = pcall(function()
        game:GetService("ReplicatedStorage").Tap:InvokeServer(true)
    end)
    
    if success then
        PerformanceMonitor.failures = math.max(0, PerformanceMonitor.failures - 1)
        PerformanceMonitor.lastSuccessful = tick()
    else
        PerformanceMonitor.failures = PerformanceMonitor.failures + 1
        
        if PerformanceMonitor.failures >= PerformanceMonitor.maxFailures and PerformanceMonitor.autoAdjust then
            -- Auto-adjust speed
            if Config.TapMode == "TURBO" then
                Config.TapMode = "Ultra"
            elseif Config.TapMode == "Ultra" then
                Config.TapMode = "Fast"
            elseif Config.TapMode == "Fast" then
                Config.TapMode = "Normal"
            end
            PerformanceMonitor.failures = 0
        end
    end
end

